 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
     "k", "|", "rhoT", "|", "muT", "|", "Arho", "|", "Amu", "|", "AG", "|", 
      "Lambda"}], ")"}], "\[Element]", 
    TemplateBox[{},
     "Reals"]}], "\[And]", 
   RowBox[{"s", "\[Element]", 
    TemplateBox[{},
     "Complexes"]}], "\[And]", 
   RowBox[{"k", ">", "0"}], "\[And]", 
   RowBox[{"rhoT", ">", "0"}], "\[And]", 
   RowBox[{"muT", ">", "0"}], "\[And]", 
   RowBox[{"Lambda", ">", "0"}], "\[And]", 
   RowBox[{
    RowBox[{"-", "1"}], "<", "Arho", "<", "1"}], "\[And]", 
   RowBox[{
    RowBox[{"-", "1"}], "<", "Amu", "<", "1"}], "\[And]", 
   RowBox[{
    RowBox[{"-", "1"}], "\[LessEqual]", "AG", "\[LessEqual]", "1"}], "\[And]", 
   RowBox[{"s", "\[NotEqual]", "0"}]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.9936378602861977`*^9, 3.993645696410637*^9, 
  3.993647700434824*^9, 3.993649247835763*^9, 3.9937152822152033`*^9, 
