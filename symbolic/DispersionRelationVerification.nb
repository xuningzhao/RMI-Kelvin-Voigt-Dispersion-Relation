Cell[CellGroupData[{

Cell["Section 0 \[LongDash] Definitions and assumptions", "Section",ExpressionUUID->"b296c0a1-defa-49ab-80f0-24cc624cf752"],

Cell["\<\
The symbolic variables include the dimensional variables gamma, k, rho1, \
rho2, mu1, mu2, G1, G2 and the nondimensional variables s, Arho, Amu, AG, \
Lambda.\
\>", "Text",ExpressionUUID->"cc980b13-5054-43ad-bb59-e77139c70a15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Phase1Symbols", "[", "]"}]], "Input",
