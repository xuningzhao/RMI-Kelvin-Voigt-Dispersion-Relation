Cell[CellGroupData[{

Cell["Forward-step audit", "Subsection",ExpressionUUID->"04aa5cf4-4e90-45c8-81e8-f578707adbc3"],

Cell["\<\
Every Phase II transformation is audited in the forward direction to verify \
that roots of the original dispersion relation cannot be lost during the \
construction of P14.\
\>", "Text",ExpressionUUID->"cfacb07d-a128-4517-ac97-bca2b01f83a4"],

