Cell["The complete dimensional dispersion relation D(gamma) is:", "Text",ExpressionUUID->"45d04bb2-1c32-4eb9-b88c-ea31f578b09b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DimensionalDispersion", "[", "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"b1f26968-c587-46c8-8168-aefa3116cc85"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"gamma", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox["G1", "gamma"], "+", "mu1"}], ")"}], " ", 
         SqrtBox[
          RowBox[{
           FractionBox[
            RowBox[{"gamma", " ", "rho1"}], 
            RowBox[{
             SuperscriptBox["k", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               FractionBox["G1", "gamma"], "+", "mu1"}], ")"}]}]], "+", 
           "1"}]]}], "+", 
        FractionBox["G2", "gamma"], "+", "mu2"}]], "+", 
      FractionBox["1", 
       RowBox[{
        FractionBox["G1", "gamma"], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox["G2", "gamma"], "+", "mu2"}], ")"}], " ", 
         SqrtBox[
          RowBox[{
           FractionBox[
            RowBox[{"gamma", " ", "rho2"}], 
            RowBox[{
             SuperscriptBox["k", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               FractionBox["G2", "gamma"], "+", "mu2"}], ")"}]}]], "+", 
           "1"}]]}], "+", "mu1"}]]}], ")"}]}], "+", 
   FractionBox[
    RowBox[{"4", " ", 
     SuperscriptBox["k", "2"]}], 
    RowBox[{"rho1", "+", "rho2"}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.993637860342311*^9, 3.9936456964663143`*^9, 
  3.993647700486826*^9, 3.993649247889908*^9, 3.99371528227252*^9, 
  3.993717455848749*^9, 3.99371911758995*^9, 3.9937220845185738`*^9, 
  3.994164095400676*^9},
 CellLabel->
  "Out[14]//TraditionalForm=",ExpressionUUID->"4f232cfa-c72c-43b5-876a-\
f9f540c0ceaa"]
}, Open  ]]
