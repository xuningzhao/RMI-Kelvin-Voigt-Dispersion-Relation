Notebook[{

Cell[CellGroupData[{
Cell["Dispersion Relation Symbolic Verification", "Title",ExpressionUUID->"670d5cce-c057-4999-8156-49dd3bd0bd9c"],

Cell["\<\
This notebook is the primary symbolic audit interface for the two-phase \
Kelvin--Voigt Richtmyer--Meshkov dispersion relation. Phase I verifies the \
transformation from the original dimensional dispersion relation D(gamma) to \
the adopted nondimensional viscous-clock relation D*Lambda(s). It \
intentionally does not derive the polynomial representation yet.\
\>", "Text",ExpressionUUID->"207c917d-bbfb-4f2a-9c63-59f17ebf5031"],

Cell[CellGroupData[{

Cell["Audit chain", "Section",ExpressionUUID->"584d95b5-b91d-4cd6-8229-17415b5bee8d"],

Cell["\<\
The long-term symbolic chain is D(gamma) -> D*(s) -> P14(s) -> Omega. In this \
first iteration, only the first arrow is implemented and verified. \
Transformations that clear denominators, square equations, or eliminate \
radicals are deferred to later phases because those operations may introduce \
spurious roots or lose admissibility information.\
\>", "Text",ExpressionUUID->"3e71e4ba-8ca3-4144-aceb-f5d145a5eda3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Notebook initialization", "Section",ExpressionUUID->"2a6b7bc8-1c03-4ca1-b20a-d1cade378fc2"],

Cell["\<\
Load the Phase I audit using a path relative to NotebookDirectory[]. The \
semicolon suppresses the full audit Association so the PDF remains a \
derivation rather than a raw implementation log. Explicit summaries are \
displayed in the next cells.\
\>", "Text",ExpressionUUID->"368a831d-1073-47fc-94dc-e62dd44d73db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"auditResult", " ", "=", " ", 
   RowBox[{"Get", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], ",", 
       " ", "\"\<audit.wl\>\""}], "}"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"ddd8ee43-0633-41e2-9361-f6cf5c634327"],

Cell["Display the audit PASS/FAIL summary.", "Text",ExpressionUUID->"f4c3d0fc-d71e-420a-ae3c-0bb4cebba515"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"auditResult", "[", "\"\<PassFailSummary\>\"", "]"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"323673c8-d065-4bd9-a887-80ac1cabe037"],

Cell[BoxData["\<\"PASS: Phase I symbolic nondimensionalization \
verified.\"\>"], "Output",
 CellChangeTimes->{3.9936378602415113`*^9, 3.993645696366377*^9, 
  3.993647700395619*^9, 3.9936492477952223`*^9, 3.993715282166497*^9, 
  3.993717455755904*^9, 3.993719117511292*^9, 3.9937220843735037`*^9, 
  3.994164095306209*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"9d1e1356-7a02-4543-a5c9-4aaa65db2dc1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", 
    RowBox[{"auditResult", "[", "\"\<EquivalenceVerified\>\"", "]"}], "]"}], ",",
    " ", 
   RowBox[{"Style", "[", 
    RowBox[{"\"\<PASS: Phase I nondimensionalization verified\>\"", ",", " ", 
     
     RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Bold", ",", " ", 
