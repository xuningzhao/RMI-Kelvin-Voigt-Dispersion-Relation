Cell[CellGroupData[{

Cell["Phase II compact variables", "Subsection",ExpressionUUID->"8b3f635e-c1c8-414e-86dd-79b6a61c2fbc"],

Cell["\<\
The polynomial derivation uses EPlus/EMinus polynomial eta factors, radicands \
RMinus/RPlus, principal radicals qMinus/qPlus, and reciprocal denominators \
BMinus/BPlus.\
\>", "Text",ExpressionUUID->"0dcff346-758a-4dac-8170-a0bcd058666d"],

