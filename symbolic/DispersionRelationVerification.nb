Cell[CellGroupData[{

Cell["Phase III \[LongDash] Polynomial-Completeness Audit", "Section",ExpressionUUID->"c2a0e106-6732-4b5a-a640-81603cc821f9"],

Cell["\<\
Phase III verifies the no-root-loss direction of the polynomial construction: \
every root of the original nondimensional dispersion relation, on its \
definition domain and under the derivation assumptions, is represented among \
the roots of P14. The reverse implication is intentionally not claimed; \
extraneous polynomial roots are expected and will be filtered later by direct \
substitution into D*Lambda.\
\>", "Text",ExpressionUUID->"fee86618-1427-40e1-994e-b13707977c07"],

Cell["\<\
Load the Phase III audit using a path relative to NotebookDirectory[].\
\>", "Text",ExpressionUUID->"4385e3e9-c2bf-4e50-90fd-f8048a5fbde9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"phase3Result", "=", 
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<audit_phase3.wl\>\""}], "}"}], "]"}], "]"}], ";"}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"7d52d08b-137e-4f3b-a3ab-e64f6c326fba"],

