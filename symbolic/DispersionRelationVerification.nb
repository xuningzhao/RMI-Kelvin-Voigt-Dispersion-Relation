Cell[CellGroupData[{

Cell["Phase I boundary", "Section",ExpressionUUID->"18ca3908-9da4-4fea-8054-9809010de456"],

Cell["\<\
This notebook has not cleared denominators, squared equations, eliminated \
radicals, or constructed the admissible domain Omega. Those operations are \
intentionally deferred to Phase II and must be audited as possible sources of \
spurious or lost roots.\
\>", "Text",ExpressionUUID->"30aabb05-a316-46c7-a0a4-5624660e6603"],

