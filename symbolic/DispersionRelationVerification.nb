Cell[CellGroupData[{

Cell["Section 2 \[LongDash] Nondimensionalization", "Section",ExpressionUUID->"7f998d0d-90e9-41d9-a265-83467e6cd266"],

Cell["\<\
The nondimensionalization substitutes gamma = s muT k^2/rhoT and reconstructs \
rho1, rho2, mu1, mu2, G1, G2 from the total scales and contrasts. The elastic \
modulus total is represented through Lambda = rhoT GT/(muT^2 k^2), so G1 and \
G2 are substituted directly in terms of Lambda.\
\>", "Text",ExpressionUUID->"4466ca26-8229-4d32-9a20-9b0639569bb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"NondimensionalizationRules", "[", "]"}], " ", "//", " ", 
  "TableForm"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"17c167be-5b13-4b74-9edb-6c5a04b746ef"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      RowBox[{"gamma", "\[Rule]", 
       FractionBox[
        RowBox[{
         SuperscriptBox["k", "2"], " ", "muT", " ", "s"}], "rhoT"]}]},
     {
      RowBox[{"rho1", "\[Rule]", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "Arho"}], ")"}], " ", "rhoT"}]}]},
     {
      RowBox[{"rho2", "\[Rule]", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "Arho"}], ")"}], " ", "rhoT"}]}]},
     {
      RowBox[{"mu1", "\[Rule]", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "Amu"}], ")"}], " ", "muT"}]}]},
     {
      RowBox[{"mu2", "\[Rule]", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "Amu"}], ")"}], " ", "muT"}]}]},
     {
      RowBox[{"G1", "\[Rule]", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "AG"}], ")"}], " ", 
         SuperscriptBox["k", "2"], " ", "Lambda", " ", 
         SuperscriptBox["muT", "2"]}], 
        RowBox[{"2", " ", "rhoT"}]]}]},
     {
      RowBox[{"G2", "\[Rule]", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "AG"}], ")"}], " ", 
         SuperscriptBox["k", "2"], " ", "Lambda", " ", 
         SuperscriptBox["muT", "2"]}], 
        RowBox[{"2", " ", "rhoT"}]]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.5599999999999999]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   Column],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.993637860353578*^9, 3.993645696469391*^9, 
  3.9936477004955387`*^9, 3.993649247898485*^9, 3.993715282275837*^9, 
  3.9937174558526583`*^9, 3.993719117593442*^9, 3.993722084524391*^9, 
  3.994164095411501*^9},
 CellLabel->
  "Out[15]//TableForm=",ExpressionUUID->"7a0b404e-6b5c-4112-b348-\
e4029609c256"]
}, Open  ]],

Cell["\<\
The adopted nondimensional expression is the Lambda form used by the \
repository's numerical implementation. It is written in compact \
implementation form here, but it is algebraically identical to the fully \
explicit expression in derivation/final_nondimensional_dispersion.md.\
\>", "Text",ExpressionUUID->"8604d890-0af2-4771-8e43-6815c0ab977d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DStarLambda", "[", "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"bf870a76-c048-4956-b6d3-006dd438870b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"s", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"AG", "+", "1"}], ")"}], " ", "Lambda"}], "s"], "+", 
           "Amu", "+", "1"}], ")"}], " ", 
         SqrtBox[
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Arho", "+", "1"}], ")"}], " ", "s"}], 
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{"AG", "+", "1"}], ")"}], " ", "Lambda"}], "s"], "+", 
             "Amu", "+", "1"}]], "+", "1"}]]}], "+", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "AG"}], ")"}], " ", "Lambda"}], "s"], "-", "Amu",
         "+", "1"}]], "+", 
      FractionBox["1", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "AG"}], ")"}], " ", "Lambda"}], "s"], "-", 
           "Amu", "+", "1"}], ")"}], " ", 
         SqrtBox[
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "Arho"}], ")"}], " ", "s"}], 
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "AG"}], ")"}], " ", "Lambda"}], "s"], "-", 
             "Amu", "+", "1"}]], "+", "1"}]]}], "+", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"AG", "+", "1"}], ")"}], " ", "Lambda"}], "s"], "+", "Amu",
         "+", "1"}]]}], ")"}]}], "+", "2"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.993637860364517*^9, 3.9936456964795637`*^9, 
  3.9936477005059*^9, 3.993649247909326*^9, 3.993715282287066*^9, 
