 CellLabel->"Out[4]=",ExpressionUUID->"226c7c7a-87dc-45c8-8b21-ab4214181332"]
}, Open  ]],

Cell["\<\
Dimensional-domain assumptions record the physical inputs before \
nondimensionalization. These are not polynomial assumptions; they simply \
state positivity/nonnegativity and gamma != 0.\
\>", "Text",ExpressionUUID->"81e7556c-7bf2-499b-9fd4-76a33f7e2a46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DimensionalDomainAssumptions", "[", "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"aa92081b-9108-4092-8801-61ba2ebafa4e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"gamma", "\[Element]", 
    TemplateBox[{},
     "Complexes"]}], "\[And]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
     "k", "|", "rho1", "|", "rho2", "|", "mu1", "|", "mu2", "|", "G1", "|", 
      "G2"}], ")"}], "\[Element]", 
    TemplateBox[{},
     "Reals"]}], "\[And]", 
   RowBox[{"gamma", "\[NotEqual]", "0"}], "\[And]", 
   RowBox[{"k", ">", "0"}], "\[And]", 
   RowBox[{"rho1", ">", "0"}], "\[And]", 
   RowBox[{"rho2", ">", "0"}], "\[And]", 
   RowBox[{"mu1", ">", "0"}], "\[And]", 
   RowBox[{"mu2", ">", "0"}], "\[And]", 
   RowBox[{"G1", "\[GreaterEqual]", "0"}], "\[And]", 
   RowBox[{"G2", "\[GreaterEqual]", "0"}], "\[And]", 
   RowBox[{
    RowBox[{"G1", "+", "G2"}], ">", "0"}]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.993637860268764*^9, 3.993645696394422*^9, 
  3.993647700420961*^9, 3.99364924782024*^9, 3.993715282198509*^9, 
  3.993717455777357*^9, 3.993719117533271*^9, 3.993722084400024*^9, 
  3.994164095326035*^9},
 CellLabel->
  "Out[5]//TraditionalForm=",ExpressionUUID->"7bf6e577-33ca-4ab5-9293-\
c1f249f600f6"]
}, Open  ]],

Cell["\<\
The original expression also contains internal denominators. These conditions \
define where the displayed dimensional expression is meaningful. They are \
recorded separately from the simplification assumptions because later phases \
must track possible lost roots and poles explicitly.\
\>", "Text",ExpressionUUID->"6a681c00-8ac3-445a-a80d-86419ebb58dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"OriginalExpressionDomainConditions", "[", "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"c11461ce-8122-4911-86a4-b1f6ce711310"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"gamma", "\[NotEqual]", "0"}], "\[And]", 
   RowBox[{"k", "\[NotEqual]", "0"}], "\[And]", 
   RowBox[{
    RowBox[{"rho1", "+", "rho2"}], "\[NotEqual]", "0"}], "\[And]", 
   RowBox[{
    RowBox[{
     FractionBox["G1", "gamma"], "+", "mu1"}], "\[NotEqual]", "0"}], "\[And]", 
   RowBox[{
    RowBox[{
     FractionBox["G2", "gamma"], "+", "mu2"}], "\[NotEqual]", "0"}], "\[And]", 
   RowBox[{
    RowBox[{
     FractionBox["G1", "gamma"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["G2", "gamma"], "+", "mu2"}], ")"}], " ", 
      SqrtBox[
       RowBox[{
        FractionBox[
         RowBox[{"gamma", " ", "rho2"}], 
         RowBox[{
          SuperscriptBox["k", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["G2", "gamma"], "+", "mu2"}], ")"}]}]], "+", "1"}]]}],
      "+", "mu1"}], "\[NotEqual]", "0"}], "\[And]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["G1", "gamma"], "+", "mu1"}], ")"}], " ", 
      SqrtBox[
       RowBox[{
        FractionBox[
         RowBox[{"gamma", " ", "rho1"}], 
         RowBox[{
          SuperscriptBox["k", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["G1", "gamma"], "+", "mu1"}], ")"}]}]], "+", "1"}]]}],
      "+", 
     FractionBox["G2", "gamma"], "+", "mu2"}], "\[NotEqual]", "0"}]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{3.993637860281426*^9, 3.993645696406314*^9, 
  3.993647700429895*^9, 3.993649247832418*^9, 3.993715282211885*^9, 
  3.993717455789742*^9, 3.993719117542248*^9, 3.9937220844100027`*^9, 
  3.994164095337015*^9},
 CellLabel->
  "Out[6]//TraditionalForm=",ExpressionUUID->"78f0695d-8ea8-43ac-ac27-\
d7776f7489d4"]
}, Open  ]],

Cell["\<\
Nondimensional-domain assumptions record positive total scales, the contrast \
intervals, Lambda > 0, and s != 0. The present symbolic theorem is \
established under the explicit assumption Lambda > 0. The limiting case \
Lambda = 0, equivalently Ek = 1, corresponds within this chosen \
parameterization to both shear moduli vanishing simultaneously and lies \
outside the scope of the current theorem. Individual elastic moduli are still \
allowed to vanish at AG = +/-1 when Lambda > 0.\
\>", "Text",ExpressionUUID->"3e10cbcc-a63d-4aea-8d81-88feb0edc379"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"NondimensionalDomainAssumptions", "[", "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"2906ee5d-e2a6-4ffc-b1aa-02834ee3519a"],

