Cell[CellGroupData[{

Cell["Section 1 \[LongDash] Original dimensional dispersion relation", \
"Section",ExpressionUUID->"c01661b2-c6b7-49cc-998f-2cbb4928cef6"],

Cell["\<\
The original dimensional expression is constructed without aggressive \
simplification. The two Kelvin--Voigt effective viscosities are eta1 = mu1 + \
G1/gamma and eta2 = mu2 + G2/gamma.\
\>", "Text",ExpressionUUID->"45c021a0-4ad1-4363-b0b3-04fee549eb17"],

