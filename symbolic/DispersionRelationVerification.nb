 RowBox[{"{", 
  RowBox[{
  "gamma", ",", "k", ",", "rho1", ",", "rho2", ",", "mu1", ",", "mu2", ",", 
   "G1", ",", "G2", ",", "rhoT", ",", "muT", ",", "s", ",", "Arho", ",", 
   "Amu", ",", "AG", ",", "Lambda"}], "}"}]], "Output",
 CellChangeTimes->{3.993637860256959*^9, 3.993645696380946*^9, 
  3.9936477004119787`*^9, 3.993649247810914*^9, 3.993715282185253*^9, 
  3.993717455768592*^9, 3.993719117524185*^9, 3.993722084379744*^9, 
